#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @COMMAND_RUNNER_FILE_VERSION_RC@
 PRODUCTVERSION @COMMAND_RUNNER_PRODUCT_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Command Runner contributors\0"
            VALUE "FileDescription", "@PROJECT_DESCRIPTION@\0"
            VALUE "FileVersion", "@COMMAND_RUNNER_FILE_VERSION@\0"
            VALUE "InternalName", "CommandRunner.exe\0"
            VALUE "LegalCopyright", "Copyright (c) Command Runner contributors\0"
            VALUE "OriginalFilename", "CommandRunner.exe\0"
            VALUE "ProductName", "Command Runner\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
