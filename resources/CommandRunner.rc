#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "CommandRunner.manifest"

IDD_COMMAND_DIALOG DIALOGEX 0, 0, 430, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Add Command"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Name:", IDC_STATIC, 8, 10, 104, 14
    EDITTEXT        IDC_COMMAND_NAME, 120, 8, 300, 18, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "&Working Directory:", IDC_STATIC, 8, 36, 104, 14
    EDITTEXT        IDC_COMMAND_WORKING_DIRECTORY, 120, 34, 224, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_COMMAND_BROWSE, 350, 33, 70, 20
    LTEXT           "Command &Line:", IDC_STATIC, 8, 62, 104, 14
    EDITTEXT        IDC_COMMAND_LINE, 120, 60, 300, 72, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Output Encoding:", IDC_STATIC, 8, 143, 104, 14
    COMBOBOX        IDC_COMMAND_ENCODING, 120, 140, 112, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "S&hell", IDC_COMMAND_SHELL, 120, 166, 80, 18, WS_TABSTOP
    AUTOCHECKBOX    "&Auto Start", IDC_COMMAND_AUTO_START, 210, 166, 100, 18, WS_TABSTOP
    DEFPUSHBUTTON   "&Save", IDC_COMMAND_SAVE, 330, 193, 42, 20, WS_TABSTOP
    PUSHBUTTON      "&Cancel", IDC_COMMAND_CANCEL, 378, 193, 42, 20, WS_TABSTOP
END

IDD_CLOSE_DIALOG DIALOGEX 0, 0, 300, 105
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Commands Are Still Running"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_CLOSE_MESSAGE, 10, 10, 280, 32
    PUSHBUTTON      "&Stop Commands and Exit", IDC_CLOSE_STOP_AND_EXIT, 10, 69, 118, 22, WS_TABSTOP
    DEFPUSHBUTTON   "&Cancel", IDC_CLOSE_CANCEL, 138, 69, 70, 22, WS_TABSTOP
    PUSHBUTTON      "&Minimize to Tray", IDC_CLOSE_TRAY, 218, 69, 72, 22, WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,5,0
 PRODUCTVERSION 0,1,5,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Command Runner contributors\0"
            VALUE "FileDescription", "Native Windows command runner\0"
            VALUE "FileVersion", "0.1.5.0\0"
            VALUE "InternalName", "CommandRunner.exe\0"
            VALUE "OriginalFilename", "CommandRunner.exe\0"
            VALUE "ProductName", "Command Runner\0"
            VALUE "ProductVersion", "0.1.5.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
